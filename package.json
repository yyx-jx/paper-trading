{
  "name": "btc-paper-trading-cs",
  "version": "0.6.1",
  "private": true,
  "main": "apps/client/electron/main.cjs",
  "description": "BTC 5-minute paper trading system with Linux-ready backend and cross-platform desktop client.",
  "scripts": {
    "dev": "npm run dev:stack",
    "dev:client": "concurrently -k -n renderer,electron \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:stack": "concurrently -k -n server,renderer,electron \"npm run dev:server\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:matching": "tsx watch apps/server/src/matching-index.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:renderer": "vite --config apps/client/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron apps/client/electron/main.cjs",
    "setup:env": "node scripts/setup-env.cjs",
    "doctor:local": "node scripts/local-doctor.cjs",
    "db:migrate": "tsx scripts/db-migrate.ts up",
    "db:status": "tsx scripts/db-migrate.ts status",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "test:migrations": "tsx scripts/db-migrate.ts check && npm run test:migration-smoke",
    "test:migration-smoke": "tsx scripts/migration-smoke-check.ts",
    "test:matching": "tsx scripts/matching-quality-check.ts",
    "test:config": "tsx scripts/config-check.ts",
    "test:permissions": "tsx scripts/user-permission-check.ts",
    "test:export": "tsx scripts/export-check.ts",
    "test:dataset-export": "tsx scripts/dataset-export-check.ts",
    "test:deployment": "tsx scripts/deployment-check.ts",
    "test:deployment-readiness": "tsx scripts/deployment-readiness-check.ts",
    "test:fault-tolerance": "tsx scripts/fault-tolerance-check.ts",
    "test:metrics": "tsx scripts/metrics-check.ts",
    "test:jsonl-rotation": "tsx scripts/jsonl-rotation-check.ts",
    "test:monitoring-deploy": "tsx scripts/monitoring-deploy-check.ts",
    "test:migration-safety": "tsx scripts/migration-safety-check.ts",
    "test:redeem-idempotency": "tsx scripts/redeem-idempotency-check.ts",
    "test:order-transactions": "tsx scripts/order-transactions-check.ts && tsx scripts/order-idempotency-check.ts",
    "test:order-idempotency": "tsx scripts/order-idempotency-check.ts",
    "test:electron-config": "tsx scripts/electron-config-check.ts",
    "test:frontend-display": "tsx scripts/frontend-display-check.ts",
    "test:production-client-load": "tsx scripts/production-client-load-test.ts",
    "test:market-ws-latency": "tsx scripts/market-ws-latency-sample.ts",
    "test:market-ws-multi-client-latency": "tsx scripts/market-ws-multi-client-latency.ts",
    "test:market-tick-payload": "tsx scripts/market-tick-payload-check.ts",
    "test:polymarket-health": "tsx scripts/polymarket-health-check.ts",
    "test:logs": "tsx scripts/log-search-check.ts",
    "test:bulk-users": "tsx scripts/bulk-user-check.ts",
    "test:csv-bulk-users": "tsx scripts/csv-bulk-user-check.ts",
    "test:ui": "electron scripts/electron-ui-check.cjs",
    "test:trading": "tsx scripts/trading-engine-check.ts && tsx scripts/limit-order-lifecycle-check.ts && tsx scripts/latency-optimization-check.ts && tsx scripts/frontend-display-check.ts",
    "test:regression": "tsx scripts/flow-regression-check.ts",
    "build": "npm run build:server && npm run build:matching && npm run build:renderer",
    "build:server": "tsup --config tsup.server.config.ts",
    "build:matching": "tsup --config tsup.matching.config.ts",
    "build:renderer": "vite build --config apps/client/vite.config.ts",
    "package:win:test": "node scripts/package-win-test.cjs",
    "package:win:prod": "node scripts/package-win-prod.cjs",
    "package:release": "node scripts/build-release-bundle.cjs",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/client/tsconfig.json",
    "start:server": "node dist/server/index.js",
    "start:matching": "node dist/matching/matching-index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.5.0",
    "https-proxy-agent": "^9.0.0",
    "i18next": "^25.5.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "recharts": "^3.2.1",
    "redis": "^5.8.3",
    "tsx": "^4.20.6",
    "undici": "^8.1.0",
    "viem": "^2.38.2",
    "ws": "^8.18.3",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.local.btcpapertrading.test",
    "productName": "BTC Paper Trading Test",
    "asar": true,
    "asarUnpack": [
      "dist/server/**/*"
    ],
    "icon": "apps/client/assets/app-icon.png",
    "extraResources": [
      {
        "from": "apps/client/assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "deploy/windows-test"
    },
    "files": [
      "package.json",
      "apps/client/electron/**/*",
      "dist/renderer/**/*",
      "dist/server/**/*"
    ],
    "win": {
      "icon": "apps/client/assets/app-icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BTC Paper Trading Test Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BTC Paper Trading Test"
    }
  }
}
