NODE_ENV=production
DEPLOY_ENV=production
PORT=8787
PUBLIC_BIND_HOST=0.0.0.0
PUBLIC_PORT=10002
PUBLIC_DOMAIN=<PRODUCTION_HOST>
PUBLIC_BASE_URL=http://<PRODUCTION_HOST>:10002
CORS_ORIGINS=http://<PRODUCTION_HOST>:10002
TRUST_PROXY=true
CADDY_CONFIG_PATH=./deploy/Caddyfile

POSTGRES_DB=paper_trading_green
POSTGRES_USER=paper_trading_green
POSTGRES_PASSWORD=CHANGE_ME_STRONG_GREEN_POSTGRES_PASSWORD
DATABASE_URL=postgresql://paper_trading_green:CHANGE_ME_STRONG_GREEN_POSTGRES_PASSWORD@postgres:5432/paper_trading_green
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_GREEN_48_BYTE_RANDOM_SECRET
EXPORT_ANONYMIZATION_SECRET=CHANGE_ME_GREEN_DIFFERENT_48_BYTE_RANDOM_SECRET

SERVER_STRICT_PERSISTENCE=true
SERVER_REQUIRE_MIGRATIONS=true
SERVER_ALLOW_DEV_SCHEMA_BOOTSTRAP=false
EXPECTED_SCHEMA_MIGRATION_ID=000008
SEED_DEFAULT_USERS=false
PERSISTENCE_MODE=external

EMBEDDED_MATCHING_SERVICE=false
MATCHING_SERVICE_URL=http://matching-service:8788
MATCHING_SERVICE_PORT=8788
MATCHING_SERVICE_TIMEOUT_MS=4000
APP_SERVER_IMAGE=p-t-app-server:0.6.3-rc1
MATCHING_SERVICE_IMAGE=p-t-matching-service:0.6.3-rc1

LOG_DIR=/app/data/logs
BACKUP_DIR=/app/backups

COINBASE_ENABLED=true
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_REST_URL=https://api.exchange.coinbase.com
COINBASE_REQUEST_TIMEOUT_MS=6000
COINBASE_REST_POLL_MS=5000
COINBASE_WS_STALE_MS=15000
BINANCE_FALLBACK_REST_URL=https://www.okx.com
BINANCE_FALLBACK_REST_POLL_MS=1000
UPSTREAM_PROXY_URL=
MARKET_WS_MIN_INTERVAL_MS=250
MARKET_SNAPSHOT_INTERVAL_MS=250
MARKET_HISTORY_CACHE_MAX_USERS=50
METRICS_ENABLED=true
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=
PROMETHEUS_RETENTION=15d

PG_MAX_CONNECTIONS=30
PG_CONNECTION_TIMEOUT_MS=30000
PG_IDLE_TIMEOUT_MS=60000
PG_KEEPALIVE=true
GAMMA_POLL_INTERVAL_MS=3000
MANUAL_SETTLEMENT_TIMEOUT_MS=300000

HYPER_BRIDGE_ENABLED=false
HYPER_GATEWAY_URL=ws://127.0.0.1:8770
HYPER_BRIDGE_RECONNECT_MS=3000
HYPER_BRIDGE_MAX_QUEUE=5000
HYPER_BRIDGE_MODE=filtered
