NODE_ENV=production
DEPLOY_ENV=production
PORT=8787
PUBLIC_DOMAIN=103.147.13.98
PUBLIC_BASE_URL=http://103.147.13.98:10001
CORS_ORIGINS=http://103.147.13.98:10001
TRUST_PROXY=true

POSTGRES_DB=paper_trading
POSTGRES_USER=paper_trading
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://paper_trading:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/paper_trading
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_48_BYTE_RANDOM_SECRET
EXPORT_ANONYMIZATION_SECRET=CHANGE_ME_DIFFERENT_48_BYTE_RANDOM_SECRET

SERVER_STRICT_PERSISTENCE=true
SERVER_REQUIRE_MIGRATIONS=true
SERVER_ALLOW_DEV_SCHEMA_BOOTSTRAP=false
EXPECTED_SCHEMA_MIGRATION_ID=000004
SEED_DEFAULT_USERS=false
PERSISTENCE_MODE=external

EMBEDDED_MATCHING_SERVICE=false
MATCHING_SERVICE_URL=http://matching-service:8788
MATCHING_SERVICE_PORT=8788
MATCHING_SERVICE_TIMEOUT_MS=4000

LOG_DIR=/app/data/logs
BACKUP_DIR=/app/backups

CHAINLINK_ENABLED=false
UPSTREAM_PROXY_URL=
MARKET_WS_MIN_INTERVAL_MS=1000
MARKET_HISTORY_CACHE_MAX_USERS=200
METRICS_ENABLED=true
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=
PROMETHEUS_RETENTION=15d

PG_MAX_CONNECTIONS=30
PG_CONNECTION_TIMEOUT_MS=30000
PG_IDLE_TIMEOUT_MS=60000
PG_KEEPALIVE=true
GAMMA_POLL_INTERVAL_MS=3000
